# Copy to .env and fill in. The backend reads these as environment variables
# (Spring Boot does NOT read .env by itself; scripts/run-backend.sh exports them).

# Existing PostgreSQL instance. Prisma-style URL postgresql://user:pass@host:port/db?schema=x
# maps to DB_URL=jdbc:postgresql://host:port/db plus DB_SCHEMA=x.
DB_URL=jdbc:postgresql://localhost:5432/your_database
DB_USERNAME=your_user
DB_PASSWORD=replace_me
DB_SCHEMA=tender

# AI: fixture (bundled demonstration analysis for the fictional tender) or live (Anthropic API).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_MODE=fixture

# Demo company switching (simulated access, NOT authentication). Set false before any real deployment.
DEMO_MODE=true
DEMO_TENDER_CLOSING_DAYS=21

TENDER_FEED_URL=https://canadabuys.canada.ca/opendata/pub/openTenderNotice-ouvertAvisAppelOffres.csv
TENDER_IMPORT_SCHEDULE_ENABLED=false
# Optional reviewed public document per CanadaBuys reference number: REF=https://...,REF2=https://...
REVIEWED_DOCUMENT_URLS=

SERVER_PORT=8090
CORS_ORIGINS=http://localhost:5173
